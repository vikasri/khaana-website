# Response headers for Cloudflare Pages. GitHub Pages ignores this file, so it
# is safe to commit before the move and it takes effect the moment DNS points
# at Cloudflare.
#
# The caching rules below are the main reason to move. GitHub Pages sends one
# blanket "cache-control: max-age=600" for everything and gives no way to
# change it, which is what made a browser hold a ten-minute-old stylesheet
# against newly deployed markup and render the cuisines menu as a long list
# inside the header. tools/version-assets.py exists to work around that. Here
# the rules can just be correct.

# Everything not matched below. Revalidate on every request: the response is
# still served from cache when unchanged (304), but a deploy is visible at
# once rather than up to ten minutes later.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  # No inline <script> anywhere on the site, so script-src can be strict.
  # style-src needs unsafe-inline for a handful of style attributes on the
  # home page. Nothing is loaded from a third party: no CDN, no web fonts, no
  # analytics. If that ever changes, this line has to change with it.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  # Six months, and deliberately without preload. Preloading is a one-way
  # door: it is baked into browser binaries and takes months to undo, so it
  # is not something to switch on while the site is still moving around.
  Strict-Transport-Security: max-age=15768000

# The JSON the Cook page reads. These are fetched without a version string,
# so they must revalidate. Cached hard, the site would keep serving last
# month's recipes to anyone who had visited before.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheet and scripts. Every reference to these carries ?v=<content hash>
# from tools/version-assets.py, so a changed file is a changed URL and the old
# one can be kept forever. This depends on that tool having run: if a page
# ever ships an unversioned reference, it will be pinned to a stale file for a
# year. build-recipe-pages.py is the last thing to run and version-assets.py
# runs after it.
/style.css
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs. Filenames are stable and the contents almost never change, but
# they do occasionally get replaced when a better licensed image turns up, so
# a month rather than a year.
/assets/images/*
  Cache-Control: public, max-age=2592000
