# Response headers for Workers static assets.
#
# IMPORTANT: rules here are ADDITIVE, not overriding. A /* rule and a specific
# rule both match, and both values are sent, so a page ended up with
#
#   cache-control: public, max-age=0, must-revalidate, public, max-age=31536000, immutable
#
# where the first max-age wins and the immutable caching never happened. So
# Cache-Control is set once per path class and never in /*, which carries only
# headers that are the same everywhere.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  # No inline <script> anywhere on the site, so script-src can be strict.
  # style-src needs unsafe-inline for a handful of style attributes on the
  # home page. Nothing is loaded from a third party: no CDN, no web fonts, no
  # analytics. If that ever changes, this line has to change with it.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  # Six months, and deliberately without preload. Preloading is a one-way
  # door: it is baked into browser binaries and takes months to undo, so it
  # is not something to switch on while the site is still moving around.
  Strict-Transport-Security: max-age=15768000

# Pages. Revalidate on every request: still served from cache when unchanged
# (304), but a deploy is visible at once rather than up to ten minutes later,
# which is the whole reason for leaving GitHub Pages.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The JSON the Cook page reads. Fetched without a version string, so it must
# revalidate. Cached hard, the site would keep serving last month's recipes to
# anyone who had visited before.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheet and scripts. Every reference carries ?v=<content hash> from
# tools/version-assets.py, so a changed file is a changed URL and the old one
# can be kept indefinitely. This depends on that tool having run: an
# unversioned reference would pin a visitor to a stale file for a year.
# version-assets.py runs last in the build for exactly this reason.
/style.css
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs. Filenames are stable and contents almost never change, but they
# do get replaced when a better licensed image turns up, so a month.
/assets/images/*
  Cache-Control: public, max-age=2592000
