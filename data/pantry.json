  "_glossary_comment": "Shown inline on recipe pages wherever a term is referenced, so unfamiliar ingredients and techniques are explained in place.",
  "glossary": {
    "tadka": {
      "term": "Tadka (tempering)",
      "text": "Whole spices bloomed in hot fat, then poured over a finished dish. The fat carries the aromatic compounds that water cannot extract, which is why the same spices taste different raw. Listen for the seeds popping; that is the cue they are done."
    },
    "hing": {
      "term": "Asafoetida (hing)",
      "text": "A dried resin with a pungent raw smell that turns savoury and onion-like when it hits hot fat. Used in tiny pinches, often in cooking that avoids onion and garlic. Most supermarket hing is cut with flour and is not gluten-free."
    },
    "bhuna": {
      "term": "Bhuna",
      "text": "Frying the masala base until the fat visibly separates from the paste at the edges of the pan. This is the doneness signal for a curry base: before it, the spices taste raw; after it, they taste round."
    },
    "dum": {
      "term": "Dum",
      "text": "Sealing a pot and cooking on very low heat so the food finishes in its own trapped steam. Traditionally the lid is sealed with dough."
    },
    "kokum": {
      "term": "Kokum",
      "text": "A dark, dried coastal fruit rind used as a souring agent along the Konkan coast. Tastes cleaner and more astringent than tamarind and lends a purple tinge."
    },
    "panch-phoron": {
      "term": "Panch phoron",
      "text": "The eastern Indian five-seed blend: fenugreek, nigella, cumin, black mustard and fennel, used whole and never ground."
    },
    "ginger-garlic-paste": {
      "term": "Ginger-garlic paste",
      "text": "Equal parts ginger and garlic blended smooth. Make it fresh where you can; the jarred version is usually preserved with acid that reads sour in delicate dishes."
    },
    "curry-leaves": {
      "term": "Curry leaves",
      "text": "Fresh leaves of Murraya koenigii, unrelated to curry powder. They lose almost everything when dried, so use fresh or frozen. Added to hot oil early so the aroma infuses the fat."
    },
    "kadhai": {
      "term": "Kadhai",
      "text": "A deep, round-bottomed Indian pan. A wok is the closest substitute; a deep saucepan works but the higher sides slow evaporation."
    },
    "resting-dough": {
      "term": "Resting dough",
      "text": "Letting kneaded dough sit lets the gluten relax so it rolls out without springing back."
    }
  },
  "_selectable_comment": "Items used in fewer than three recipes are kept here but marked selectable:false. They stay out of the pantry UI, which is the point, while their proper names and their recipes' ingredient ids remain valid. Deleting them instead broke validation and downgraded 'Bitter gourd (karela)' to 'Bitter Gourd' on the match cards."
}